# Environment configuration for opencode-for-ctf
#
# Copy this file to .env and set the values for your system.
# Then run: node scripts/setup.mjs
#
# This will generate the platform-specific opencode.json config
# with your paths filled in.

# ============================================================
# Required
# ============================================================

# Path to the opencode-for-ctf plugin directory (the root of this repo)
# Example:
#   PLUGIN_DIR=C:\path\to\Opencode-for-CTF   (Windows)
#   PLUGIN_DIR=/home/user/Opencode-for-CTF   (Linux/Mac)
PLUGIN_DIR=

# CTF workspace directory (where your challenge files live)
# Example: C:\path\to\ctf-workspace  or  /home/user/ctf-workspace
WORKSPACE_DIR=

# Allowed roots for local file tools (platform path-delimiter separated).
# Defaults to the current project directory + worktree when unset.
# Windows: C:\ctf\workspace;C:\ctf\shared
# Linux/Mac: /home/user/ctf:/tmp/ctf
# CTF_ALLOWED_ROOTS=

# Extra hosts allowed for ctf-web-probe beyond public HTTP(S) and localhost.
# Comma-separated. Private/link-local targets must be listed explicitly.
# CTF_ALLOWED_HOSTS=10.10.10.5,lab.internal

# ============================================================
# AI Providers
# ============================================================

# DeepSeek API Key (recommended primary provider)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ============================================================
# Search & Web
# ============================================================

# Jina AI API Key — web search / scraping
# https://jina.ai/
JINA_API_KEY=

# Brave Search API Key
# https://brave.com/search/api/
BRAVE_API_KEY=

# Firecrawl API Key — web scraping
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# Tavily API Key — web search for AI agents
# https://tavily.com/
TAVILY_API_KEY=

# AnySearch API Key
ANYSEARCH_API_KEY=

# ============================================================
# GitHub
# ============================================================

# GitHub Personal Access Token (read-only, for code search)
# https://github.com/settings/tokens
GITHUB_PAT=

# ============================================================
# Reverse Engineering
# ============================================================

# Ghidra installation directory (for ReVa MCP)
# Example: C:\Program Files\ghidra_12.0.4_PUBLIC
GHIDRA_INSTALL_DIR=

# GDB MCP command. Use a wrapper command or script that starts your chosen GDB MCP server on stdio.
# GDB_MCP_COMMAND=

# x64dbg MCP command and debugger path. Use only on authorized local Windows reversing targets.
# X64DBG_MCP_COMMAND=
# X64DBG_PATH=

# CyberChef MCP is optional. There is no official `cyberchef-mcp` npm package;
# set CYBERCHEF_MCP_COMMAND to your own CyberChef MCP server command to enable it.
# CYBERCHEF_MCP_COMMAND=

# ============================================================
# Service MCPs (optional — enable only for authorized targets)
# ============================================================

# MySQL MCP command and connection details.
# MYSQL_MCP_COMMAND=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# SSH MCP command and connection details.
# SSH_MCP_COMMAND=
# SSH_MCP_HOST=
# SSH_MCP_PORT=22
# SSH_MCP_USER=
# SSH_MCP_KEY=

# ============================================================
# Docker Images (optional — change if using custom CTF images)
# ============================================================

# Prefix for PWN docker images (default: pwnlab)
# CTF_PWN_IMAGE_PREFIX=pwnlab

# Pin a specific PWN docker image (overrides prefix + suffix)
# CTF_PWN_IMAGE=pwnlab:general-ubuntu22.04

# Prefix for REV docker images (default: revlab)
# CTF_REV_IMAGE_PREFIX=revlab

# ============================================================
# Proxy (optional — set if behind a corporate/great-firewall proxy)
# ============================================================

# HTTP/HTTPS proxy for curl, wget, and other network tools
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# ============================================================
# Local Knowledge Retrieval (required for Phase ② recall)
# ============================================================
# Local retrieval is served by the external RAG-Agent `ctf_rag` stdio server:
# a read-only index over a local cybersecurity corpus (CTF writeups, CVE and
# technique notes) backed by faiss plus a local Ollama embedding model. The
# plugin ships no corpus of its own, and the retired SecKB/CVEKB backends are
# gone — `ctf_rag` is the only local retrieval backend.
#
# The server is part of the ctf-fast default MCP profile and the plugin launches
# it at runtime from its own registry, so no `mcp.ctf_rag` entry belongs in
# opencode.jsonc — do not add one: this host expands {env:VAR} into the config
# text before parsing, and a placeholder that resolves to a Windows path injects
# raw backslashes that break the whole config.
#
# All three values are required; without them activation records a non-fatal
# "missing env" skip and the solve continues without local recall.
#
# CTF_RAG_PYTHON: interpreter of the RAG-Agent virtualenv (its venv has faiss)
# CTF_RAG_ROOT:   RAG-Agent checkout root; used as PYTHONPATH because an MCP
#                 client cannot pass a working directory
# CTF_RAG_KB_ROOT: knowledge-base root that contains <kb>/vector_store/<model>/
#
# CTF_RAG_PYTHON=C:\Projects\Agent-projects\RAG-Agent\.venv\Scripts\python.exe
# CTF_RAG_ROOT=C:\Projects\Agent-projects\RAG-Agent
# CTF_RAG_KB_ROOT=C:\RAG-Agent-Data\data\knowledge_base
