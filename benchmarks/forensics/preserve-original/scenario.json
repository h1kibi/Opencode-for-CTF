{
  "schemaVersion": 1,
  "id": "forensics/preserve-original",
  "family": "forensics",
  "description": "Deterministic behavior contract scenario: pass must satisfy the family checker and fail must be rejected.",
  "passArtifact": ".scenario/pass",
  "failArtifact": ".scenario/fail",
  "traceContract": {
    "pass": {
      "requiredOrdered": [
        "originals.preserved",
        "triage.completed",
        "route.selected",
        "provenance.recorded",
        "reconstruction.verified"
      ],
      "forbidden": ["originals.overwritten"]
    },
    "fail": {
      "requiredOrdered": ["extraction.started"],
      "forbidden": ["originals.preserved"]
    }
  }
}
