{
  "schemaVersion": 1,
  "id": "pwn/remote-drift",
  "family": "pwn",
  "description": "Deterministic behavior contract scenario: pass must satisfy the family checker and fail must be rejected.",
  "passArtifact": ".scenario/pass",
  "failArtifact": ".scenario/fail",
  "traceContract": {
    "pass": {
      "requiredOrdered": ["binary.probed", "remote.failed", "remote_drift.checked", "drift.probe.targeted"],
      "forbidden": ["primitive.rotated"]
    },
    "fail": {
      "requiredOrdered": ["binary.probed", "remote.failed", "primitive.rotated"],
      "forbidden": ["remote_drift.checked"]
    }
  }
}
