{
  "name": "opencode-for-ctf",
  "version": "0.1.2",
  "description": "OpenCode CTF agent plugin: agents, commands, skills, tools, local RAG, and MCP orchestration for authorized CTF solving.",
  "license": "MIT",
  "homepage": "https://github.com/h1kibi/Opencode-for-CTF#readme",
  "keywords": [
    "opencode",
    "ctf",
    "plugin",
    "security",
    "capture-the-flag"
  ],
  "bugs": "https://github.com/h1kibi/Opencode-for-CTF/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/h1kibi/Opencode-for-CTF.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./dist/plugin/index.js",
  "exports": {
    ".": "./dist/plugin/index.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "opencode-for-ctf": "./scripts/cli.mjs"
  },
  "preferGlobal": false,
  "files": [
    "agents",
    "commands",
    "dist/plugin",
    "dist/wiremcp",
    "rag/knowledge/lessons",
    "rag/knowledge/retros",
    "rag/knowledge/retros/retros.index.json",
    "rag/knowledge/sources",
    "rag/knowledge/sources/des-ctf-knowledge.manifest.json",
    "rag/knowledge/sources/secknowledge-skill.manifest.json",
    "rag/knowledge/pwn",
    "rag/knowledge/rev",
    "rag/knowledge/pwn-patterns.md",
    "rag/knowledge/weak-modules-hard-backlog.md",
    "rag/knowledge/pattern-cards/ljagiello-ctf-skills.cards.v9.json",
    "rag/knowledge/pattern-cards/java-web",
    "rag/knowledge/pattern-cards/pwn-curated.cards.v1.json",
    "rag/knowledge/pattern-cards/des-ctf/des-ctf.cards.v1.json",
    "rag/knowledge/pattern-cards/synonyms.json",
    "rag/knowledge/pattern-cards/curated-cards.json",
    "rag/lessons",
    "requirements.txt",
    "requirements-misc.txt",
    "rules",
    "runtime/README.md",
    "runtime/win-env",
    "runtime/wsl-env",
    "skills",
    "templates",
    "third_party",
    "scripts/lib",
    "mcp-server/README.md",
    "mcp-server/ctf-tools-mcp-server.mjs",
    "mcp-server/launchers",
    "mcp-server/vendor/WireMCP/index.js",
    "mcp-server/vendor/WireMCP/package.json",
    "mcp-server/vendor/WireMCP/README.md",
    "mcp-server/vendor/WireMCP/LICENSE",
    "mcp-server/vendor/WireMCP/Wire-MCP.png",
    "scripts/cli.mjs",
    "scripts/install.mjs",
    "scripts/upgrade.mjs",
    "scripts/uninstall.mjs",
    "scripts/status.mjs",
    "scripts/doctor-install.mjs",
    "scripts/release-check.mjs",
    "scripts/build-plugin.mjs",
    "scripts/fetch-skills.mjs",
    "scripts/import-ctf-knowledge.mjs",
    "scripts/build-retros-index.mjs",
    "scripts/setup.mjs",
    "README.md",
    "LICENSE",
    ".env.example",
    "opencode-for-ctf.example.jsonc"
  ],
  "scripts": {
    "check": "tsc --noEmit && npm run check:content && vitest run && npm run benchmark:scenarios",
    "check:content": "node scripts/validate-content.mjs",
    "check:benchmarks": "node scripts/ctf-benchmark.ts web && node scripts/ctf-benchmark.ts pwn && node scripts/ctf-benchmark.ts rev && node scripts/ctf-benchmark.ts crypto && node scripts/ctf-benchmark.ts forensics && node scripts/ctf-benchmark.ts misc",
    "build:plugin": "node scripts/build-plugin.mjs",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tools,scripts,test,packages}/**/*.{ts,js,mjs,cjs,json,md}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"{src,tools,scripts,test,packages}/**/*.{ts,js,mjs,cjs,json,md}\" \"*.{json,md,mjs}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tools:verify": "tsx scripts/verify-ctf-tooling.ts",
    "doctor": "node scripts/doctor-install.mjs",
    "doctor:tooling": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "ctf:install": "node scripts/install.mjs",
    "ctf:upgrade": "node scripts/upgrade.mjs",
    "ctf:status": "node scripts/status.mjs",
    "ctf:uninstall": "node scripts/uninstall.mjs",
    "ctf:doctor": "node scripts/doctor-install.mjs",
    "ctf:help": "node scripts/cli.mjs help",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "npm run build:plugin && npm run release:check",
    "pack:check": "npm run prepack && npm pack --dry-run --ignore-scripts",
    "fetch-skills": "node scripts/fetch-skills.mjs",
    "doctor:rev": "tsx scripts/doctor-rev.ts",
    "doctor:android-rev": "tsx scripts/doctor-android-rev.ts",
    "doctor:image-ocr": "tsx scripts/doctor-image-ocr.ts",
    "doctor:go-rev": "tsx scripts/doctor-go-rev.ts",
    "doctor:revlab": "tsx scripts/doctor-revlab.ts",
    "doctor:godot-rev": "tsx scripts/doctor-godot-rev.ts",
    "ctf:evidence-doctor": "tsx scripts/ctf-evidence-doctor.ts",
    "benchmark:nyu": "tsx scripts/ctf-benchmark-nyu.ts",
    "benchmark:nyu:setup": "node scripts/setup-nyu-benchmark.mjs",
    "benchmark:scenarios": "node scripts/ctf-benchmark-scenarios.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opencode-ai/plugin": "^1.17.0",
    "@opencode-ai/sdk": "^1.0.0",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.1.0"
  },
  "opencode": {
    "type": "plugin",
    "description": "CTF agent ecosystem plugin. Provides runtime hooks (continuation, team-mode, skill MCP lifecycle) plus skills, tools, commands, and agents for CTF solving.",
    "provides": [
      "runtime-hooks",
      "ctf-agents",
      "ctf-skills",
      "ctf-tools",
      "ctf-commands"
    ]
  },
  "ctf": {
    "manifest": "ctf-agent.manifest.json",
    "note": "Agent config, entrypoints, and required tool/index manifests. See ctf-agent.manifest.json and agents/*.md."
  }
}
