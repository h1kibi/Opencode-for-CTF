{
  // Optional user config for opencode-for-ctf.
  // Search order (closest wins): project walk → $OPENCODE_CONFIG_DIR → ~/.config/opencode/
  // Filenames: opencode-for-ctf.jsonc | opencode-for-ctf.json

  // Default intensity for /ctf auto-routing (BINDING when mode is not forced).
  // auto = pure heuristics; fast|expert = force that lane via ctf-route-plan + /ctf hook.
  "default_mode": "auto", // auto | fast | expert

  // Disable individual runtime hooks.
  // Allowed: hashline | permission_auto_allow | chat_params | session_compacting
  //          | continuation | skill_mcp | team_events
  "disabled_hooks": [],

  "hashline": {
    "enabled": true
  },

  "continuation": {
    "enabled": true
  },

  "team_mode": {
    "enabled": true,
    "max_workers": 8
  },

  // Tool packs registered at plugin startup (restart OpenCode after changes).
  // This is the PROCESS registry (superset). ctf-fast is still filtered by allowlist.
  // Default omits rare/heavy/maintenance packs: maintenance, pwn-heavy, web-heavy, rev-heavy, java, forensics-heavy, android, android-dynamic, godot.
  // Use ["all"] for true full expert environment, or list packs explicitly.
  // "tool_packs": ["core", "web", "pwn", "rev", "crypto", "forensics", "misc", "java"],
  // "tool_packs": ["all"],
  // Optional merge into registry for expert-heavy machines:
  // "expert_tool_packs": ["maintenance", "pwn-heavy", "web-heavy", "rev-heavy", "java", "forensics-heavy", "android", "android-dynamic", "godot"],

  // Recommended MCP backend notes:
  // - browser uses @playwright/mcp by default.
  // - wireshark-mcp uses the bundled WireMCP server copied by the managed installer.
  // - gdb-mcp / mysql-mcp / x64dbg-mcp / ssh-mcp use env-backed command wrappers.
  // - cyberchef-mcp uses {env:CYBERCHEF_MCP_COMMAND}; there is no official npm package, so it is disabled by default.
  // - ctfd-mcp uses `npx -y ctfd-mcp-server` and is disabled by default.
  // - ctf_rag is the RAG-Agent local corpus index. It is part of the ctf-fast
  //   default MCP profile (read-only retrieval, no shell/target access) and the
  //   plugin activates it per session from its own registry, passing a real
  //   config object over the API.
  //   Do NOT add a static `mcp.ctf_rag` entry here: its values are
  //   machine-specific absolute paths, and this host expands `{env:VAR}` into
  //   the config TEXT before parsing it, so a placeholder that resolves to a
  //   Windows path (`C:\...`) injects raw backslashes and makes the whole config
  //   unparseable. Set the environment variables below instead (see .env.example).
  //   The server declares its tool as `ctf_rag`; hosts that namespace MCP tools
  //   expose `ctf_rag_ctf_rag`. The fast-lane allowlist permits both.

  // Example disabled MCP stubs for workspace-level opencode.jsonc:
  // "mcp": {
  //   "browser": {
  //     "type": "local",
  //     "command": ["npx", "-y", "@playwright/mcp@latest"],
  //     "enabled": false
  //   },
  //   "wireshark-mcp": {
  //     "type": "local",
  //     "command": ["node", "/absolute/path/to/opencode-for-ctf/mcp-server/vendor/WireMCP/index.js"],
  //     "enabled": false
  //   },
  //   "gdb-mcp": {
  //     "type": "local",
  //     "command": ["{env:GDB_MCP_COMMAND}"],
  //     "enabled": false
  //   },
  //   "mysql-mcp": {
  //     "type": "local",
  //     "command": ["{env:MYSQL_MCP_COMMAND}"],
  //     "environment": {
  //       "MYSQL_HOST": "{env:MYSQL_HOST}",
  //       "MYSQL_PORT": "{env:MYSQL_PORT}",
  //       "MYSQL_USER": "{env:MYSQL_USER}",
  //       "MYSQL_PASSWORD": "{env:MYSQL_PASSWORD}",
  //       "MYSQL_DATABASE": "{env:MYSQL_DATABASE}"
  //     },
  //     "enabled": false
  //   },
  //   "x64dbg-mcp": {
  //     "type": "local",
  //     "command": ["{env:X64DBG_MCP_COMMAND}"],
  //     "environment": { "X64DBG_PATH": "{env:X64DBG_PATH}" },
  //     "enabled": false
  //   },
  //   "ssh-mcp": {
  //     "type": "local",
  //     "command": ["{env:SSH_MCP_COMMAND}"],
  //     "environment": {
  //       "SSH_MCP_HOST": "{env:SSH_MCP_HOST}",
  //       "SSH_MCP_PORT": "{env:SSH_MCP_PORT}",
  //       "SSH_MCP_USER": "{env:SSH_MCP_USER}",
  //       "SSH_MCP_KEY": "{env:SSH_MCP_KEY}"
  //     },
  //     "enabled": false
  //   },
  //   "cyberchef-mcp": {
  //     "type": "local",
  //     "command": ["{env:CYBERCHEF_MCP_COMMAND}"],
  //     "enabled": false
  //   },
  //   "ctfd-mcp": {
  //     "type": "local",
  //     "command": ["npx", "-y", "ctfd-mcp-server"],
  //     "enabled": false
  //   }
  // },

  "external_skills": true
}
