{
  "version": "0.1.2",
  "description": "CTF agent operating profile. Default user entry is /ctf (auto-route). Primary CTF agents: ctf-fast and ctf-expert only. researcher owns manual post-solve learning and local knowledge RAG maintenance.",
  "default_entrypoints": ["/ctf", "/help", "/ctf-fast", "/ctf-expert", "/resume"],
  "compatibility_entrypoints": [],
  "primary_agents": ["ctf-fast", "ctf-expert"],
  "compatibility_agents": [],
  "support_primary_agents": ["researcher"],
  "category_subagents": ["ctf-web", "ctf-pwn", "ctf-rev", "ctf-crypto", "ctf-forensics", "ctf-misc", "ctf-aisec"],
  "meta_subagents": ["ctf-scout", "ctf-librarian", "ctf-oracle", "ctf-verifier"],
  "routing": {
    "tool": "ctf-route-plan",
    "skill": "ctf-router",
    "core_module": "packages/ctf-core/src/router.ts"
  },
  "required_tools": [
    "ctf-route-plan",
    "ctf-decision-state",
    "ctf-one-shot-triage",
    "ctf-web-blackbox-map",
    "ctf-java-analyze",
    "ctf-artifact-analyze",
    "ctf-pwn-runner",
    "ctf-pattern-card-search",
    "ctf-pattern-to-hypothesis"
  ],
  "optional_pack_tools": [
    "ctf-source-first-pack",
    "ctf-web-recon-pack",
    "ctf-java-analyze-pack",
    "ctf-apk-triage",
    "ctf-android-native-triage",
    "ctf-android-runtime-check",
    "ctf-android-runtime-doctor",
    "ctf-android-dynamic-macro",
    "ctf-dex-patch-map",
    "ctf-android-packed-closure-helper",
    "ctf-jadx-targeted-slice",
    "ctf-artifact-page",
    "ctf-pwn-redflag-panel",
    "ctf-pwn-disasm-constraint-map",
    "ctf-pwn-stack-frame-solver",
    "ctf-pwn-got-leak-router",
    "ctf-pwn-stage-harness",
    "ctf-pwn-stage-delta-runner",
    "ctf-pwn-io-diff-check",
    "ctf-pe-unpack",
    "ctf-pe-hybrid-rebuild",
    "ctf-runtime-dump",
    "ctf-memstr",
    "ctf-rev-pe-recovery",
    "ctf-windows-expect-runner",
    "ctf-windows-debug-helper",
    "ctf-lesson-search",
    "ctf-retro-search",
    "ctf-skill-repo-search",
    "ctf-imported-knowledge-search"
  ],
  "required_scripts": [
    "scripts/ctf-config-qa.ts",
    "scripts/init-ctf-evidence.ts",
    "scripts/write-evidence-state.ts",
    "scripts/read-evidence-state.ts",
    "scripts/init-rev-team-memory.ts",
    "scripts/update-rev-team-memory.ts",
    "scripts/read-rev-team-memory.ts",
    "scripts/check-command-helper-contracts.ts"
  ],
  "required_state_files": [
    "work/ctf-evidence/<challenge-slug>/inventory.md",
    "work/ctf-evidence/<challenge-slug>/route.json",
    "work/ctf-evidence/<challenge-slug>/hypotheses.json",
    "work/ctf-evidence/<challenge-slug>/signal-memory.yaml",
    "work/ctf-evidence/<challenge-slug>/primitive.json",
    "work/ctf-evidence/<challenge-slug>/closure.json"
  ],
  "rev_team_state_files": [
    "work/ctf-evidence/<challenge-slug>/rev-team-memory.json",
    "work/ctf-evidence/<challenge-slug>/rev-team-summary.md"
  ],
  "required_indexes": [
    "rag/knowledge/lessons/lessons.index.json",
    "rag/knowledge/retros/retros.index.json",
    "rag/knowledge/pattern-cards/ljagiello-ctf-skills.cards.v9.json",
    "rag/knowledge/pattern-cards/java-web/java-web.cards.v1.json",
    "rag/knowledge/pattern-cards/pwn-curated.cards.v1.json",
    "rag/knowledge/pattern-cards/des-ctf/des-ctf.cards.v1.json",
    "rag/knowledge/pattern-cards/synonyms.json",
    "rag/knowledge/sources/des-ctf-knowledge.manifest.json"
  ],
  "qa_required": true,
  "readiness_gate": {
    "config_contracts": true,
    "evidence_packet_bootstrap": true,
    "fanout_contract": true,
    "lesson_index_presence": true,
    "benchmark_smoke": true,
    "expert_required_tools": [
      "ctf-team-dispatch",
      "ctf-team-status",
      "ctf-team-collect",
      "ctf-team-cancel",
      "ctf-team-cancel-route",
      "ctf-team-close",
      "ctf-team-recover",
      "ctf-team-adopt",
      "ctf-evidence-board",
      "ctf-mcp-control",
      "ctf-decompose-task"
    ],
    "expert_soft_dependencies": ["ida", "jadx", "ghidra", "apktool", "frida"]
  }
}
